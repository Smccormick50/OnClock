rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // One profile doc per user: name, email, role ("employee" or "admin").
    // Signed-in coworkers may read the directory so an employee can select
    // the person who should approve a submitted work week.
    match /users/{userId} {
      allow read: if isSignedIn();

      // A user can create their own profile (always as "employee" —
      // the client always sends role: "employee" on signup).
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.role == 'employee';

      // A user can update their own profile but not their own role.
      // Only an admin can change someone's role.
      allow update: if isAdmin()
                    || (isSignedIn() && request.auth.uid == userId
                        && request.resource.data.role == resource.data.role);

      allow delete: if isAdmin();
    }

    // One doc per employee per day, id = "<uid>_<YYYY-MM-DD>".
    // Holds that day's clock in/out sessions and notes.
    match /entries/{entryId} {
      // `resource == null` covers reading a day that has no doc yet
      // (e.g. an employee's very first clock-in, or an admin looking
      // at a date nobody logged anything on) — without this check,
      // Firestore errors trying to read `resource.data` off a
      // nonexistent document, which the client sees as a permission
      // error instead of "not found".
      allow read: if isSignedIn() &&
                    (resource == null || resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                    (request.resource.data.uid == request.auth.uid || isAdmin());

      allow update, delete: if isSignedIn() &&
                    (resource.data.uid == request.auth.uid || isAdmin());
    }

    // One doc per employee per day, id = "<uid>_<YYYY-MM-DD>", written
    // only by the nightly archive script (scripts/archive-daily.js,
    // run by GitHub Actions) via the Admin SDK, which authenticates
    // with a service account and bypasses these rules entirely.
    // Clients only ever read.
    match /archives/{archiveId} {
      allow read: if isSignedIn() &&
                    (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Append-only change history. Signed-in users can record their own
    // actions; administrators can review all records. No browser client
    // can alter or remove an audit record after it is created.
    match /auditLogs/{auditId} {
      allow create: if isSignedIn()
                    && request.resource.data.actorUid == request.auth.uid
                    && request.resource.data.targetUid is string
                    && request.resource.data.action is string
                    && (
                      isAdmin()
                      || request.resource.data.targetUid == request.auth.uid
                      || (
                        request.resource.data.approvalId is string
                        && exists(/databases/$(database)/documents/weeklyApprovals/$(request.resource.data.approvalId))
                        && get(/databases/$(database)/documents/weeklyApprovals/$(request.resource.data.approvalId)).data.approverUid == request.auth.uid
                        && get(/databases/$(database)/documents/weeklyApprovals/$(request.resource.data.approvalId)).data.employeeUid == request.resource.data.targetUid
                      )
                    );
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.actorUid == request.auth.uid);
      allow update, delete: if false;
    }

    // A frozen Monday-Sunday snapshot submitted by an employee to one
    // selected approver. The employee can submit/resubmit their own week;
    // the assigned approver can only change its decision fields; admins can
    // review every approved week on the Completed Approvals tab.
    match /weeklyApprovals/{approvalId} {
      allow read: if isSignedIn() && (
                    isAdmin()
                    || resource.data.employeeUid == request.auth.uid
                    || resource.data.approverUid == request.auth.uid
                  );

      allow create: if isSignedIn()
                    && request.resource.data.employeeUid == request.auth.uid
                    && request.resource.data.approverUid is string
                    && request.resource.data.approverUid != request.auth.uid
                    && request.resource.data.status == 'pending';

      allow update: if isAdmin()
                    || (
                      isSignedIn()
                      && resource.data.employeeUid == request.auth.uid
                      && resource.data.status == 'returned'
                      && request.resource.data.employeeUid == request.auth.uid
                      && request.resource.data.status == 'pending'
                      && request.resource.data.approverUid != request.auth.uid
                    )
                    || (
                      isSignedIn()
                      && resource.data.approverUid == request.auth.uid
                      && resource.data.status == 'pending'
                      && request.resource.data.status in ['approved', 'returned']
                      && request.resource.data.employeeUid == resource.data.employeeUid
                      && request.resource.data.approverUid == resource.data.approverUid
                      && request.resource.data.snapshot == resource.data.snapshot
                      && request.resource.data.totalMinutes == resource.data.totalMinutes
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'status', 'approvedAt', 'approvedAtIso', 'approvedByUid', 'approvedByName',
                        'returnedAt', 'returnedAtIso', 'returnedByUid', 'returnedByName',
                        'returnComment', 'lastUpdatedAt'
                      ])
                    );

      allow delete: if isAdmin();
    }

    // Each employee's running to-do list — one doc per user, not tied
    // to a date, since unfinished items should carry over day to day.
    // Only the owner ever reads or writes it (not admins — it's a
    // personal working list; completed items get logged into that
    // day's `entries` doc instead, where the existing rules already
    // cover admin visibility).
    match /todos/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Each employee's pending mileage log — one doc per user, holding
    // trips not yet exported/submitted for reimbursement. Owner-only,
    // same reasoning as todos: this is a personal working list before
    // submission, not an official record admins need to see here (the
    // actual reimbursement form is the exported Excel file itself,
    // handed to accounting outside the app).
    match /mileage/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
